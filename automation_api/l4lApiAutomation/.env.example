# API automation suite — environment template
# Copy this file to `.env.<ENV>` (e.g. `.env.development`) in this folder.
# The suite loads `.env.${ENV}`; ENV defaults to `development` (see playwright.config.ts).
# Never commit real credentials — .env.* files must stay gitignored.

# --- Database (used for test data validation queries) ---
DB_HOST=localhost
DB_NAME=local4local
DB_USER=postgres
DB_PASS=changeme

# --- Test accounts (must exist in the target environment) ---
EMAIL_MUNICIPALITY=municipality-user@example.com
EMAIL_SUPPLIER=supplier-user@example.com
EMAIL_SUPPLIER_REJECTED=rejected-supplier@example.com
EMAIL_CITIZEN=citizen-user@example.com
PASSWORD=changeme

# --- Roles (role IDs as used by the API) ---
ROLE_MUNICIPALITY=0
ROLE_SUPPLIER=1
ROLE_CITIZEN=2

# --- Test entity IDs (UUIDs from the target environment) ---
TENANT_ID=00000000-0000-0000-0000-000000000000
SUPPLIER_ID=00000000-0000-0000-0000-000000000000
SUPPLIER_REJECTED_ID=00000000-0000-0000-0000-000000000000
PASSHOLDER_ID=00000000-0000-0000-0000-000000000000
CITIZEN_GROUP_ID=00000000-0000-0000-0000-000000000000
USER_CITIZEN_ID=00000000-0000-0000-0000-000000000000
USER_MUNICIPALITY_ID=00000000-0000-0000-0000-000000000000
