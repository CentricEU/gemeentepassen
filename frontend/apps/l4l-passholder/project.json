{
  "name": "l4l-passholder",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/l4l-passholder/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/l4l-passholder",
        "index": "apps/l4l-passholder/src/index.html",
        "main": "apps/l4l-passholder/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/l4l-passholder/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "./libs/shared-assets/",
            "output": "/assets/"
          },
          {
            "input": "apps/l4l-passholder/src/assets/.well-known",
            "glob": "**/*",
            "output": "/.well-known/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/@windmill/windmill/src/lib/assets/windmill-svg-icons",
            "output": "./assets/windmill-svg-icons"
          }
        ],
        "styles": [
          "apps/l4l-passholder/src/styles.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "6mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "7kb",
              "maximumError": "14kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/l4l-passholder/src/environment/environment.ts",
              "with": "apps/l4l-passholder/src/environment/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "beta": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "15mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "7kb",
              "maximumError": "20kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/l4l-passholder/src/environment/environment.ts",
              "with": "apps/l4l-passholder/src/environment/environment.beta.ts"
            }
          ],
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        },
        "acceptance": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "13mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "7kb",
              "maximumError": "14kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/l4l-passholder/src/environment/environment.ts",
              "with": "apps/l4l-passholder/src/environment/environment.acceptance.ts"
            }
          ],
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "l4l-passholder:build:production"
        },
        "development": {
          "buildTarget": "l4l-passholder:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "l4l-passholder:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/l4l-passholder/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "l4l-passholder:build",
        "port": 4200,
        "spa": true
      }
    }
  }
}