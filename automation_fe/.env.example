# UI automation suite — environment template
# Copy this file to `.env.<ENV>` (e.g. `.env.uidevelopment`) in this folder.
# The suite loads `.env.${ENV}`; ENV defaults to `uidevelopment` (see playwright.config.ts).
# Never commit real credentials — .env.* files must stay gitignored.

# --- Application URLs ---
MUNICIPALITY_URL=http://localhost:4200
SUPPLIER_URL=http://localhost:4201
CITIZEN_URL=http://localhost:4202
CITIZEN_APPLY_FOR_PASS_URL=http://localhost:4202/apply-for-pass

# --- Test accounts (must exist in the target environment) ---
EMAIL_MUNICIPALITY_ADMIN=municipality-admin@example.com
EMAIL_MUNICIPALITY_SUPER_ADMIN=municipality-superadmin@example.com
EMAIL_SUPPLIER=supplier-user@example.com
EMAIL_CITIZEN=citizen-user@example.com
PASSWORD=changeme

# --- Database (used for test data validation queries) ---
DB_HOST=localhost
DB_NAME=local4local
DB_USER=postgres
DB_PASS=changeme
